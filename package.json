{
  "name": "asciigraph",
  "version": "0.1.0",
  "private": true,
  "description": "Object-based ASCII/Unicode diagram editor: boxes, text and connectors, rendered as text.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test -c e2e/playwright.config.mjs"
  },
  "dependencies": {
    "js-base64": "^3.9.6",
    "pako": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
